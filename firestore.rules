rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug']) && 
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 100)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500));
    }

    function isValidFlashSale(data) {
      return data.keys().hasAll(['title', 'image', 'isActive']) &&
             data.title is string && data.title.size() <= 200 &&
             data.image is string && data.image.size() <= 500 &&
             data.isActive is bool;
    }

    // Product Rules
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banner Rules
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings Rules
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Order Rules
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status', 'createdAt', 'address', 'phone']) &&
             data.total is number && data.total >= 0 &&
             data.items is list && data.items.size() > 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.address is string && data.address.size() <= 500 &&
             data.phone is string && data.phone.size() <= 20;
    }

    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data) && (
                      (isSignedIn() && request.resource.data.userId == request.auth.uid) || 
                      (request.resource.data.userId == 'guest')
                    );
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false; // Orders should be permanent or just cancelled
    }

    // Coupon Rules
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Category Rules
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    // Flash Sale Rules
    match /flashSales/{saleId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidFlashSale(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admin List
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'mdkawsarforazi.biz@gmail.com';
    }
    
    // User Profiles
    function isValidUserProfile(data) {
      return data.keys().hasAll(['name', 'phone', 'address']) &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.address is string && data.address.size() <= 500;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(request.resource.data);
    }

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
